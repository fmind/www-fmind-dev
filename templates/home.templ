package templates

import (
	"fmt"
	"strings"
)

var gradients = []string{
	"from-accent to-blue-500",
	"from-blue-500 to-cyan-500",
	"from-rose-500 to-red-500",
	"from-orange-500 to-amber-500",
	"from-cyan-500 to-blue-500",
	"from-emerald-500 to-teal-500",
}

templ HeroSection() {
	<div class="hero min-h-screen bg-base-200 relative overflow-hidden flex items-center justify-center">
		<div class="hero-content text-center z-10 relative px-4">
			<div class="max-w-5xl">
				<!-- Avatar -->
				<div class="avatar mb-8">
					<div class="w-40 h-40 md:w-48 md:h-48 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2 shadow-2xl overflow-hidden mx-auto">
						<img
							class="object-cover w-full h-full"
							src={ StaticURL("static/img/avatar-192.webp") }
							srcset={ fmt.Sprintf("%s 192w, %s 280w, %s 384w", StaticURL("static/img/avatar-192.webp"), StaticURL("static/img/avatar-280.webp"), StaticURL("static/img/avatar.webp")) }
							sizes="(max-width: 768px) 160px, 192px"
							alt={ METADATA.Name }
							width="192"
							height="192"
							decoding="async"
						/>
					</div>
				</div>
				<!-- Headline -->
				<h1 class="text-5xl md:text-7xl font-heading font-black mb-4 bg-clip-text text-transparent bg-gradient-to-r from-primary to-blue-600 select-text">
					{ METADATA.Name }
				</h1>
				<h2 class="text-xl md:text-3xl font-heading font-medium text-base-content/90 mb-10 max-w-4xl mx-auto leading-relaxed text-balance select-text">
					{ METADATA.HeadlinePrimary }
					<span class="inline md:hidden">• </span>
					<br class="hidden md:block"/>
					{ METADATA.HeadlineSecondary }
				</h2>
				<!-- Actions -->
				<div class="flex flex-wrap justify-center gap-4 md:gap-8">
					<a
						class="btn btn-lg bg-primary/5 hover:bg-primary/10 text-primary border border-primary/20 rounded-xl shadow-lg hover:scale-105 active:scale-95 transition-transform hover:shadow-xl hover:shadow-primary/10 px-6 py-3 font-semibold"
						href={ templ.SafeURL("mailto:" + METADATA.Email) }
					>
						Contact Me
					</a>
					<a
						class="btn btn-primary btn-lg bg-primary text-white border-none rounded-xl shadow-lg ring-2 ring-primary/40 hover:scale-105 active:scale-95 transition-transform hover:shadow-xl hover:shadow-primary/20 px-6 py-3 font-semibold"
						href={ templ.SafeURL(METADATA.CalendarURL) }
						target="_blank"
						rel="noopener noreferrer"
					>
						Book a Session
					</a>
				</div>
				<!-- Scroll Down -->
				<div class="mt-16 animate-bounce flex justify-center">
					<a class="text-primary hover:text-primary-focus transition-colors duration-300" href="#about" aria-label="Scroll to About section">
						@Icon("arrow_down", "h-10 w-10")
					</a>
				</div>
			</div>
		</div>
	</div>
}

templ AboutSection() {
	<section class="py-24 bg-base-100 overflow-hidden px-4" id="about">
		<div class="container mx-auto">
			<!-- Section Header -->
			<div class="text-center mb-12">
				<h2 class="text-4xl md:text-5xl font-heading font-bold mb-4 text-base-content">
					About <span class="text-primary">Me</span>
				</h2>
				<p class="text-xl text-base-content/70 max-w-3xl mx-auto leading-relaxed text-balance">
					Transforming AI/ML initiatives into secure, scalable, and high-impact solutions.
				</p>
			</div>
			<!-- Biography -->
			<div class="grid md:grid-cols-12 gap-8 mb-16">
				<div class="md:col-span-10 md:col-start-2 space-y-6">
					<div class="prose prose-lg text-base-content/80 text-justify mx-auto leading-loose [&_p]:leading-loose space-y-6 select-text">
						for _, para := range BIOGRAPHY {
							<p class="select-text">
								@templ.Raw(para)
							</p>
						}
					</div>
				</div>
			</div>
			<!-- Core Expertise Divider -->
			<h3 class="text-xl font-bold mb-10 flex items-center justify-center gap-2">
				<span class="w-2 h-8 bg-primary rounded-full"></span>
				Core Expertise & Skills
			</h3>
			<!-- Cards Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
				for i, card := range EXPERTISE {
					<div class="card bg-base-200/50 backdrop-blur-sm hover:bg-base-200 transition-all duration-300 hover:-translate-y-2 border border-base-300 hover:border-primary/30 overflow-hidden h-full shadow-xl hover:shadow-2xl group">
						<!-- Top Gradient Bar -->
						<div class={ "h-1 bg-gradient-to-r", gradients[i%len(gradients)] }></div>
						<div class="card-body p-6 items-center text-center">
							<div class="text-5xl mb-3 group-hover:scale-110 transition-transform duration-300">
								{ card.Emoji }
							</div>
							<h4 class="font-bold text-lg text-base-content">{ card.Title }</h4>
							<p class="text-sm text-base-content/70 mt-2 leading-relaxed">{ card.Description }</p>
						</div>
					</div>
				}
			</div>
		</div>
	</section>
}

templ WorkExperienceSection() {
	<section class="py-24 bg-base-200 px-4" id="work-experience">
		<div class="container mx-auto">
			<!-- Section Header -->
			<div class="text-center mb-16">
				<h2 class="text-4xl md:text-5xl font-heading font-bold mb-4 text-base-content">
					Work <span class="text-primary">Experience</span>
				</h2>
				<p class="text-xl text-base-content/70 max-w-3xl mx-auto leading-relaxed text-balance">
					A track record of engineering scale, reliability, and security for industry-leading institutions.
				</p>
			</div>
			<!-- Experience Timeline Grid -->
			<ul class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
				for _, item := range EXPERIENCES {
					<li class="h-full">
						<div class="card card-side bg-base-100 shadow-xl border-l-4 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 h-full flex flex-col sm:flex-row overflow-hidden group" style={ fmt.Sprintf("border-left-color: %s;", item.BrandColor) }>
							<!-- Logo Figure Container (Left side) -->
							<figure class="w-full sm:w-1/3 p-6 shrink-0 flex items-center justify-center min-h-[150px] bg-slate-50 border-r border-base-200">
								<div class="rounded-lg p-2 flex items-center justify-center w-full h-full max-h-24 max-w-[150px]">
									<img
										class="object-contain w-full h-full max-h-20 filter"
										src={ StaticURL(fmt.Sprintf("static/img/companies/%s", item.Logo)) }
										alt={ item.Company }
										width="150"
										height="80"
										loading="lazy"
										decoding="async"
									/>
								</div>
							</figure>
							<!-- Experience Info (Right side) -->
							<div class="card-body w-full sm:w-2/3 p-6 flex flex-col justify-between">
								<div>
									<h3 class="card-title text-lg md:text-xl font-bold leading-tight text-base-content select-text">
										{ item.Title }
									</h3>
									<p class="text-sm font-semibold text-primary mt-1 select-text">{ item.Company }</p>
									<p class="text-base-content/80 text-sm mt-4 text-justify leading-relaxed select-text">
										{ item.Description }
									</p>
								</div>
								<!-- Tag Badges -->
								<div class="card-actions justify-start gap-1.5 mt-6">
									for _, tag := range item.Tags {
										<div class="badge badge-outline text-xs border-base-content/25 py-2 px-2.5 font-medium select-none">
											{ tag }
										</div>
									}
								</div>
							</div>
						</div>
					</li>
				}
			</ul>
		</div>
	</section>
}

templ CertificationsSection() {
	<section class="py-24 bg-base-100 px-4" id="certifications">
		<div class="container mx-auto">
			<!-- Section Header -->
			<div class="text-center mb-16">
				<h2 class="text-4xl md:text-5xl font-heading font-bold mb-4 text-primary">Certifications</h2>
				<p class="text-xl text-base-content/70 max-w-3xl mx-auto leading-relaxed text-balance">
					Validated capabilities from leading cloud providers and academic networks.
				</p>
			</div>
			<!-- Credentials Badges Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 justify-items-center max-w-6xl mx-auto mb-16">
				for _, badge := range BADGES {
					<a
						class={ "group relative flex items-center gap-3.5 p-4 bg-base-100 rounded-2xl border-2 transition-all duration-300 w-full", templ.KV("border-primary shadow-lg hover:shadow-primary/20 hover:-translate-y-1", badge.Active), templ.KV("border-base-content/20 shadow-sm hover:border-base-content/40 hover:-translate-y-0.5", !badge.Active) }
						href={ templ.SafeURL(badge.URL) }
						target="_blank"
						rel="noopener noreferrer"
					>
						<!-- Logo Container -->
						<div class="p-2.5 rounded-xl group-hover:bg-base-300 transition-colors shrink-0 flex items-center justify-center w-16 h-16 bg-slate-50 border border-base-200">
							<img
								class="w-11 h-11 object-contain"
								src={ StaticURL(fmt.Sprintf("static/img/certifications/%s", badge.Logo)) }
								alt={ badge.Issuer }
								width="44"
								height="44"
								loading="lazy"
								decoding="async"
							/>
						</div>
						<!-- Content Info -->
						<div class="flex-1 min-w-0">
							<h3 class={ "font-bold text-base md:text-md leading-tight line-clamp-2 transition-colors select-text", templ.KV("text-primary", badge.Active), templ.KV("text-base-content group-hover:text-accent", !badge.Active) }>
								{ badge.Title }
							</h3>
							<p class="text-xs text-base-content/60 mt-1.5 truncate select-text" title={ fmt.Sprintf("%s • %s", badge.Issuer, badge.CertID) }>
								{ badge.Issuer } • { badge.CertID }
							</p>
						</div>
						<!-- Link Indicator Icon -->
						if badge.Active {
							@Icon("external_link", "w-4 h-4 transition-opacity shrink-0 text-primary opacity-50 group-hover:opacity-100")
						} else {
							@Icon("external_link", "w-4 h-4 transition-opacity shrink-0 text-accent opacity-0 group-hover:opacity-100")
						}
					</a>
				}
			</div>
			<!-- Specializations & Foundations Divider -->
			<div class="relative py-8 max-w-6xl mx-auto">
				<div class="absolute inset-0 flex items-center" aria-hidden="true">
					<div class="w-full border-t border-base-300"></div>
				</div>
				<div class="relative flex justify-center">
					<span class="bg-base-100 px-6 text-sm text-base-content/70 uppercase tracking-widest font-semibold select-none">
						Specializations & Foundations
					</span>
				</div>
			</div>
			<!-- Specializations Entry Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-w-6xl mx-auto mt-6">
				for _, entry := range SPECIALIZATIONS {
					<a
						class="group flex items-center gap-4 p-4 rounded-xl hover:bg-base-200 border border-transparent hover:border-base-300 transition-all cursor-pointer"
						href={ templ.SafeURL(entry.URL) }
						target="_blank"
						rel="noopener noreferrer"
					>
						<!-- Mini Logo -->
						<img
							class="w-10 h-10 object-contain shrink-0"
							src={ StaticURL(fmt.Sprintf("static/img/certifications/%s", entry.Logo)) }
							alt={ entry.Title }
							width="40"
							height="40"
							loading="lazy"
							decoding="async"
						/>
						<!-- Entry Info -->
						<div class="min-w-0 flex-1">
							<h4 class="text-sm md:text-base font-semibold text-base-content group-hover:text-primary transition-colors line-clamp-2 select-text">
								{ entry.Title }
							</h4>
							<p class="text-xs md:text-sm text-base-content/70 mt-0.5 select-text">{ entry.IssuerDetails }</p>
						</div>
						<!-- Indicator -->
						@Icon("external_link", "w-4 h-4 ml-auto text-base-content/30 group-hover:text-primary transition-colors opacity-0 group-hover:opacity-100 shrink-0")
					</a>
				}
			</div>
		</div>
	</section>
}

templ PublicationsSection() {
	<section class="py-24 bg-base-200 px-4" id="publications">
		<div class="container mx-auto">
			<!-- Section Header -->
			<div class="text-center mb-16">
				<h2 class="text-4xl md:text-5xl font-heading font-bold mb-4 text-primary">Publications</h2>
				<p class="text-xl text-base-content/70 max-w-3xl mx-auto leading-relaxed text-balance">
					Sharing research, insights, and structural guidelines with the global engineering community.
				</p>
			</div>
			<!-- Content Grid: Left Column (Academic) & Right Column (Featured Articles) -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start max-w-6xl mx-auto">
				<!-- Left Column: Thesis & Academic Papers -->
				<div class="lg:col-span-7 space-y-8">
					<!-- PhD Thesis Highlight Card -->
					<div class="group card bg-base-100 shadow-xl border-l-4 border-primary hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
						<div class="card-body p-6 md:p-8">
							<div class="badge badge-primary badge-outline font-semibold mb-3 select-none">PhD Thesis</div>
							<a
								class="card-title text-xl md:text-2xl font-bold mb-2 group-hover:text-accent transition-colors inline-flex items-center gap-2 select-text"
								href={ templ.SafeURL(THESIS.URL) }
								target="_blank"
								rel="noopener noreferrer"
							>
								{ THESIS.Title }
								@Icon("external_link", "w-5 h-5 text-accent opacity-0 group-hover:opacity-100 transition-opacity shrink-0")
							</a>
							<p class="text-base-content/70 italic text-sm mb-4 select-text">
								{ THESIS.InstitutionDetails }
							</p>
							<p class="mb-6 text-justify text-sm md:text-base leading-relaxed text-base-content/85 select-text">
								{ THESIS.Description }
							</p>
							<div class="card-actions flex flex-wrap gap-2">
								for _, link := range THESIS.Links {
									<a
										class="btn btn-ghost btn-xs sm:btn-sm border border-base-300 hover:bg-base-200"
										href={ templ.SafeURL(link.URL) }
										target="_blank"
										rel="noopener noreferrer"
									>
										@Icon("github", "w-4 h-4 mr-1.5")
										{ link.Label }
									</a>
								}
							</div>
						</div>
					</div>
					<!-- Academic Research List -->
					<div class="space-y-8">
						<h3 class="text-2xl font-bold mb-6 text-base-content flex items-center gap-2">
							@Icon("academic_cap", "w-6 h-6 text-primary")
							Academic Research
						</h3>
						<div class="space-y-4">
							for _, paper := range PAPERS {
								<div class="group card bg-base-100 shadow-sm hover:shadow-md transition-all duration-300 border border-base-300 border-l-2 border-l-transparent hover:border-l-primary/50">
									<div class="card-body p-5">
										<a
											class="font-bold text-base md:text-md group-hover:text-accent transition-colors inline-flex items-center gap-1.5 select-text"
											href={ templ.SafeURL(paper.URL) }
											target="_blank"
											rel="noopener noreferrer"
										>
											{ paper.Title }
											@Icon("external_link", "w-4 h-4 text-accent opacity-0 group-hover:opacity-100 transition-opacity shrink-0")
										</a>
										<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mt-3">
											<p class="text-base-content/60 text-xs md:text-sm truncate min-w-0 select-text">
												{ paper.Venue }
											</p>
											if paper.Code != "" {
												<div class="card-actions shrink-0">
													<a
														class="btn btn-ghost btn-xs sm:btn-sm border border-base-300 hover:bg-base-200"
														href={ templ.SafeURL(paper.Code) }
														target="_blank"
														rel="noopener noreferrer"
													>
														@Icon("github", "w-4 h-4 mr-1.5")
														{ paper.CodeLabel }
													</a>
												</div>
											}
										</div>
									</div>
								</div>
							}
						</div>
					</div>
				</div>
				<!-- Right Column: Curated Posts -->
				<div class="lg:col-span-5 space-y-6">
					<h3 class="text-2xl font-bold text-base-content flex items-center gap-2">
						<span class="w-2 h-8 bg-primary rounded-full"></span>
						Featured Posts
					</h3>
					<div class="card bg-base-100 shadow-xl border border-base-300 overflow-hidden">
						<div class="card-body p-2 divide-y divide-base-200">
							for _, post := range POSTS {
								<a
									class="flex items-start gap-3 p-4 hover:bg-base-200 transition-colors duration-200 group"
									href={ templ.SafeURL(post.URL) }
									target="_blank"
									rel="noopener noreferrer"
								>
									<div class="mt-0.5 shrink-0 text-accent">
										@Icon("medium", "w-5 h-5")
									</div>
									<span class="text-sm font-semibold text-base-content/85 group-hover:text-primary transition-colors leading-snug select-text">
										{ post.Title }
									</span>
									@Icon("external_link", "w-4 h-4 shrink-0 text-accent opacity-0 group-hover:opacity-100 transition-opacity ml-auto")
								</a>
							}
						</div>
					</div>
					<a
						class="btn btn-outline btn-primary btn-md w-full shadow-md rounded-xl hover:scale-[1.01] transition-transform font-bold"
						href="https://fmind.medium.com/"
						target="_blank"
						rel="noopener noreferrer"
					>
						@Icon("medium", "w-5 h-5 mr-2")
						More publications on Medium
						@Icon("external_link", "w-4 h-4 ml-1.5")
					</a>
				</div>
			</div>
		</div>
	</section>
}

templ ProjectsSection() {
	<section class="py-24 bg-base-100 px-4" id="projects">
		<div class="container mx-auto">
			<!-- Section Header -->
			<div class="text-center mb-16">
				<h2 class="text-4xl md:text-5xl font-heading font-bold mb-4 text-primary">Projects</h2>
				<p class="text-xl text-base-content/70 max-w-3xl mx-auto leading-relaxed text-balance">
					Open-source repositories and educational deep dives created to upskill engineers worldwide.
				</p>
			</div>
			<!-- Open Source Projects Section -->
			<div class="mb-16 max-w-6xl mx-auto">
				<h3 class="text-2xl font-bold mb-6 text-base-content">
					<a
						class="inline-flex items-center gap-2.5 group hover:text-accent transition-colors"
						href="https://github.com/fmind"
						target="_blank"
						rel="noopener noreferrer"
					>
						@Icon("github", "w-6 h-6 text-primary group-hover:text-accent transition-colors")
						<span>Open Source Projects</span>
						@Icon("external_link", "w-5 h-5 text-accent shrink-0")
					</a>
				</h3>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					for _, project := range OPEN_SOURCE {
						<div class="card bg-base-200 shadow-xl hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-base-300 hover:border-primary/30 group overflow-hidden">
							<!-- Top Gradient Accent line -->
							<div class="h-0.5 bg-gradient-to-r from-primary to-blue-400"></div>
							<div class="card-body p-6 flex flex-col justify-between">
								<div>
									<h3 class="card-title text-lg font-bold flex items-center gap-2 select-none">
										@Icon("github", "w-5 h-5 group-hover:scale-110 transition-transform duration-300")
										<a
											class="text-base-content group-hover:text-primary transition-colors hover:underline decoration-2 underline-offset-4 select-text"
											href={ templ.SafeURL(project.Href) }
											target="_blank"
											rel="noopener noreferrer"
										>
											{ project.Title }
										</a>
										@Icon("external_link", "w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity shrink-0")
									</h3>
									<p class="text-sm text-base-content/85 mt-4 leading-relaxed text-justify select-text">
										{ project.Description }
									</p>
								</div>
								<div class="card-actions justify-end mt-6">
									if project.Repo != "" {
										<a
											class="btn btn-sm btn-ghost hover:bg-base-300 font-semibold gap-1"
											href={ templ.SafeURL(project.Repo) }
											target="_blank"
											rel="noopener noreferrer"
										>
											View Code
											<span class="group-hover:translate-x-1 transition-transform inline-block">→</span>
										</a>
									} else {
										<a
											class="btn btn-sm btn-ghost hover:bg-base-300 font-semibold gap-1"
											href={ templ.SafeURL(project.Href) }
											target="_blank"
											rel="noopener noreferrer"
										>
											View Code
											<span class="group-hover:translate-x-1 transition-transform inline-block">→</span>
										</a>
									}
								</div>
							</div>
						</div>
					}
				</div>
			</div>
			<!-- YouTube Series Section -->
			<div class="max-w-6xl mx-auto">
				<h3 class="text-2xl font-bold mb-6 text-base-content">
					<a
						class="inline-flex items-center gap-2.5 group hover:text-accent transition-colors"
						href="https://www.youtube.com/@BleedingAgent"
						target="_blank"
						rel="noopener noreferrer"
					>
						@Icon("youtube", "w-6 h-6 text-red-500 group-hover:text-accent transition-colors")
						<span>YouTube Series</span>
						@Icon("external_link", "w-5 h-5 text-accent shrink-0")
					</a>
				</h3>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					for _, playlist := range YOUTUBE_SERIES {
						<a
							class="card bg-base-200 shadow-xl hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-base-300 block group overflow-hidden"
							href={ templ.SafeURL(playlist.URL) }
							target="_blank"
							rel="noopener noreferrer"
						>
							<!-- Top Gradient Accent line -->
							<div class="h-0.5 bg-gradient-to-r from-primary to-blue-400"></div>
							<div class="card-body p-6">
								<h3 class="card-title text-base-content group-hover:text-primary transition-colors flex items-center gap-1.5 select-none">
									<span class="font-bold text-lg">{ playlist.Title }</span>
									@Icon("external_link", "w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity shrink-0")
								</h3>
								<p class="text-sm text-base-content/85 mt-3 leading-relaxed text-justify select-text">
									{ playlist.Description }
								</p>
								<div class="card-actions justify-end mt-6">
									<div class="btn btn-sm btn-ghost hover:bg-base-300 font-semibold gap-1">
										{ playlist.CTA }
										<span class="group-hover:translate-x-1 transition-transform inline-block">→</span>
									</div>
								</div>
							</div>
						</a>
					}
				</div>
			</div>
		</div>
	</section>
}

templ ServicesSection() {
	<section class="py-24 bg-base-200 overflow-hidden relative px-4" id="services">
		<div class="container mx-auto">
			<!-- Section Header -->
			<div class="text-center mb-16">
				<h2 class="text-4xl md:text-5xl font-heading font-bold mb-4 text-base-content">
					My <span class="text-primary">Services</span>
				</h2>
				<p class="text-xl text-base-content/70 max-w-3xl mx-auto leading-relaxed text-balance">
					Leave deep AI/ML expertise for your next enterprise-level initiative.
				</p>
			</div>
			<!-- Services Cards Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
				for _, service := range GetServices() {
					<div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-all duration-300 border-2 border-primary group rounded-2xl overflow-hidden">
						<div class="card-body p-8 items-center text-center">
							<!-- Large Icon -->
							<span class="text-6xl mb-4 inline-block group-hover:scale-110 transition-transform duration-300 select-none">
								{ service.Icon }
							</span>
							<h3 class="card-title text-2xl font-heading font-bold text-base-content select-text">
								{ service.Title }
							</h3>
							<p class="text-base-content/70 mt-3 text-sm md:text-base leading-relaxed select-text">
								{ service.Description }
							</p>
							<div class={ "badge gap-1 mt-6 font-semibold py-3 px-4 select-none", fmt.Sprintf("badge-%s text-%s-content", service.BadgeType, service.BadgeType) }>
								{ service.Badge }
							</div>
							<!-- CTA Button -->
							<div class="card-actions mt-8 w-full justify-center">
								if strings.HasPrefix(service.CTAURL, "mailto:") {
									<a
										class="btn btn-primary bg-primary hover:bg-primary/90 text-white border-none rounded-xl shadow-md hover:scale-105 transition-transform hover:shadow-lg w-full max-w-[220px] py-3 text-center font-bold"
										href={ templ.SafeURL(service.CTAURL) }
									>
										{ service.CTAText }
									</a>
								} else {
									<a
										class="btn btn-primary bg-primary hover:bg-primary/90 text-white border-none rounded-xl shadow-md hover:scale-105 transition-transform hover:shadow-lg w-full max-w-[220px] py-3 text-center font-bold"
										href={ templ.SafeURL(service.CTAURL) }
										target="_blank"
										rel="noopener noreferrer"
									>
										{ service.CTAText }
									</a>
								}
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</section>
}

templ Home() {
	<div>
		@HeroSection()
		@AboutSection()
		@WorkExperienceSection()
		@CertificationsSection()
		@PublicationsSection()
		@ProjectsSection()
		@ServicesSection()
	</div>
}
