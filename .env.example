# Runtime environment: development | production. Default: development.
ENVIRONMENT=development
# HTTP listen port. Default: 8080.
PORT=8080
# Optional: set to an OTLP endpoint to export traces (e.g. http://localhost:4318).
# Unset = spans are used only for trace_id/span_id log correlation (no exporter).
# OTEL_EXPORTER_OTLP_ENDPOINT=
